# Supabase
# Copy this file to .env.local and fill in the values from Supabase -> Connect.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# SERVER ONLY - never expose this as NEXT_PUBLIC_* and never commit the real value.
# Get it from Supabase -> Project Settings -> API -> Secret keys.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVER_ONLY_KEY
